APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ALLOW_ARTISAN_SERVE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database — MySQL 8 (docker-compose service name: "mysql").
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=data_sync
DB_USERNAME=data_sync
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue, cache and atomic locks run on Redis (docker-compose service: "redis").
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum SPA (cookie) auth for the Inertia dashboard. Comma-separated hosts
# that receive the session cookie; include the port used in the browser.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Data Sync engine (see config/sync.php)
# ---------------------------------------------------------------------------
SYNC_INTERVAL_MINUTES=5              # scheduler cadence per provider (5–10)
SYNC_MAX_RPS=5                       # max outbound requests/sec per provider
SYNC_JOB_TRIES=3                     # attempts before dead-lettering
SYNC_JOB_BACKOFF=1,2,4              # per-attempt backoff seconds (exponential)
SYNC_JOB_RETRY_UNTIL=600            # stop retrying after N seconds
SYNC_JOB_UNIQUE_FOR=600            # per-provider unique lock TTL (seconds)
SYNC_CONSECUTIVE_FAILURE_LIMIT=5   # trips the circuit breaker
SYNC_BREAKER_COOLDOWN=120          # skip a tripped provider for N seconds
SYNC_DELETE_GUARD_RATIO=0.5        # cancel deletes above this fraction (E18)
SYNC_MISSING_STOCK_POLICY=keep     # keep | zero | null (FakeStore has no stock)

HTTP_CONNECT_TIMEOUT=5
HTTP_REQUEST_TIMEOUT=15
HTTP_MAX_BACKOFF=30

# Providers
PROVIDER_DUMMYJSON_ENABLED=true
PROVIDER_DUMMYJSON_BASE_URL=https://dummyjson.com
PROVIDER_DUMMYJSON_PAGE_SIZE=30
PROVIDER_FAKESTORE_ENABLED=true
PROVIDER_FAKESTORE_BASE_URL=https://fakestoreapi.com
PROVIDER_FAKESTORE_PAGE_SIZE=100

# Alerting (webhook notification deferred; structured-log alerts always on)
ALERT_SYNC_FAILURE_STREAK=3
ALERT_DLQ_THRESHOLD=10
ALERT_QUEUE_BACKLOG_THRESHOLD=100
ALERT_DEBOUNCE_MINUTES=5
ALERT_WEBHOOK_URL=

# API throttling ("requests,minutes")
API_THROTTLE_DEFAULT=60,1
API_THROTTLE_TRIGGER=10,1
